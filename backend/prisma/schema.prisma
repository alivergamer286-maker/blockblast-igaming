generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String    @unique
  passwordHash     String
  balance          Decimal   @default(1000) @db.Decimal(18, 2)
  role             String    @default("user")
  status           String    @default("active")
  banReason        String?
  emailVerified    Boolean   @default(true)
  cpf              String?
  // override: % of stake that can return to this player (null = use global)
  playerReturnPct  Decimal?  @db.Decimal(6, 2)
  // off | auto | force_hook | force_tight
  engagementMode   String    @default("off")
  gamesPlayed      Int       @default(0)
  referredById     String?
  referredBy       User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]    @relation("Referrals")
  lastLoginAt      DateTime?
  lastLoginIp      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         GameSession[]
  transactions     Transaction[]
  scores           Score[]
  auditLogs        AuditLog[] @relation("AuditActor")
  withdrawals      WithdrawalRequest[]
  emailTokens      EmailToken[]
  affiliateProfile AffiliateProfile?


  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([referredById])
}


model AffiliateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String   @unique
  commissionRate  Decimal  @default(0.10) @db.Decimal(5, 4)
  totalReferrals  Int      @default(0)
  totalWagered    Decimal  @default(0) @db.Decimal(18, 2)
  totalCommission Decimal  @default(0) @db.Decimal(18, 2)
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt


  @@index([code])
  @@index([active])
}


model PlatformConfig {
  id                  String   @id @default("default")
  houseEdge           Decimal  @default(0.05) @db.Decimal(5, 4)
  pointsPerUnit       Decimal  @default(500) @db.Decimal(18, 4)
  maxMultiplier       Decimal  @default(10) @db.Decimal(10, 2)
  minBet              Decimal  @default(1) @db.Decimal(18, 2)
  maxBet              Decimal  @default(100) @db.Decimal(18, 2)
  returnCap           Decimal  @default(2.0) @db.Decimal(10, 4)
  // % of stake that returns to player (20 = max R$4 on R$20 bet). House keeps the rest of the stake edge.
  playerReturnPct     Decimal  @default(100) @db.Decimal(6, 2)
