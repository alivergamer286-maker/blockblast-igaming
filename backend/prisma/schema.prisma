generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  username        String         @unique
  passwordHash    String
  balance         Decimal        @default(1000) @db.Decimal(18, 2)
  role            String         @default("user")
  status          String         @default("active")
  banReason       String?
  emailVerified   Boolean        @default(false)
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        GameSession[]
  transactions    Transaction[]
  scores          Score[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  withdrawals     WithdrawalRequest[]
  emailTokens     EmailToken[]

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
}

model EmailToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  type      String   @default("verify") // verify | reset
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model GameSession {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  status        String     @default("active")
  score         Int        @default(0)
  linesCleared  Int        @default(0)
  combos        Int        @default(0)
  maxCombo      Int        @default(0)
  boardState    Json
  currentPieces Json
  pieceIndex    Int        @default(0)
  betAmount     Decimal    @default(0) @db.Decimal(18, 2)
  payout        Decimal    @default(0) @db.Decimal(18, 2)
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  moves         Move[]

  @@index([userId])
  @@index([status])
  @@index([score])
}

model Move {
  id            String      @id @default(uuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id])
  pieceIndex    Int
  pieceShape    Json
  positionX     Int
  positionY     Int
  linesCleared  Int         @default(0)
  pointsEarned  Int         @default(0)
  boardAfter    Json
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  amount        Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal  @db.Decimal(18, 2)
  reference     String?
  description   String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Score {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  score         Int
  linesCleared  Int
  maxCombo      Int
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([score])
  @@index([createdAt])
  @@index([userId, score])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  status      String   @default("pending")
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
