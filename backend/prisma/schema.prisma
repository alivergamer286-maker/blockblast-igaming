generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String         @id @default(uuid())
  email           String         @unique
  username        String         @unique
  passwordHash    String
  balance         Decimal        @default(1000) @db.Decimal(18, 2)
  role            String         @default("user")
  status          String         @default("active")
  banReason       String?
  emailVerified   Boolean        @default(false)
  cpf             String?
  referredById    String?
  referredBy      User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]         @relation("Referrals")
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  sessions        GameSession[]
  transactions    Transaction[]
  scores          Score[]
  auditLogs       AuditLog[]     @relation("AuditActor")
  withdrawals     WithdrawalRequest[]
  emailTokens     EmailToken[]
  affiliateProfile AffiliateProfile?

  @@index([email])
  @@index([username])
  @@index([role])
  @@index([status])
  @@index([referredById])
}

model AffiliateProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code            String   @unique
  commissionRate  Decimal  @default(0.10) @db.Decimal(5, 4)
  totalReferrals  Int      @default(0)
  totalWagered    Decimal  @default(0) @db.Decimal(18, 2)
  totalCommission Decimal  @default(0) @db.Decimal(18, 2)
  active          Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([code])
  @@index([active])
}

model PlatformConfig {
  id              String   @id @default("default")
  houseEdge       Decimal  @default(0.05) @db.Decimal(5, 4)
  pointsPerUnit   Decimal  @default(500) @db.Decimal(18, 4)
  maxMultiplier   Decimal  @default(10) @db.Decimal(10, 2)
  minBet          Decimal  @default(1) @db.Decimal(18, 2)
  maxBet          Decimal  @default(100) @db.Decimal(18, 2)
  /** max fraction of stake that can return (e.g. 0.2 = up to 20% of bet) */
  returnCap       Decimal  @default(2.0) @db.Decimal(10, 4)
  updatedAt       DateTime @updatedAt
}

model EmailToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  type      String   @default("verify")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model GameSession {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  status        String     @default("active")
  score         Int        @default(0)
  linesCleared  Int        @default(0)
  combos        Int        @default(0)
  maxCombo      Int        @default(0)
  boardState    Json
  currentPieces Json
  pieceIndex    Int        @default(0)
  betAmount     Decimal    @default(0) @db.Decimal(18, 2)
  payout        Decimal    @default(0) @db.Decimal(18, 2)
  potentialWin  Decimal    @default(0) @db.Decimal(18, 2)
  startedAt     DateTime   @default(now())
  endedAt       DateTime?
  moves         Move[]

  @@index([userId])
  @@index([status])
  @@index([score])
}

model Move {
  id            String      @id @default(uuid())
  sessionId     String
  session       GameSession @relation(fields: [sessionId], references: [id])
  pieceIndex    Int
  pieceShape    Json
  positionX     Int
  positionY     Int
  linesCleared  Int         @default(0)
  pointsEarned  Int         @default(0)
  boardAfter    Json
  createdAt     DateTime    @default(now())

  @@index([sessionId])
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  type          String
  amount        Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal  @db.Decimal(18, 2)
  reference     String?
  description   String?
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model Score {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  score         Int
  linesCleared  Int
  maxCombo      Int
  durationMs    Int?
  createdAt     DateTime @default(now())

  @@index([score])
  @@index([createdAt])
  @@index([userId, score])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

model WithdrawalRequest {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  status      String   @default("pending")
  cpf         String?
  pixKey      String?
  fullName    String?
  note        String?
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
